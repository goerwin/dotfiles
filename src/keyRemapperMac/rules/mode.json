// "Mode - *" rules (mirrors .config/karabiner/rules/mode.ts)
[
  // Mode - VIM
  {
    "from": ["H", "J", "K", "L"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "if": "vimShift",
    "to": [
      "ShiftL+LeftArrow",
      "ShiftL+DownArrow",
      "ShiftL+UpArrow",
      "ShiftL+RightArrow"
    ]
  },
  {
    "from": ["H", "J", "K", "L"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "to": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"]
  },
  {
    "from": ["F"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "to": "set:vimShift",
    "afterKeyUp": "unset:vimShift"
  },

  // Mode - Click
  {
    "from": ["AltL"],
    "optional": ["any"],
    "to": "AltL set:clickMode",
    "afterKeyUp": "unset:clickMode"
  },
  {
    "from": ["C"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "if": "clickMode",
    "to": "AltL:up RightClick"
  },
  {
    "from": ["C"],
    "optional": ["any"],
    "if": "clickMode",
    "to": "AltL:up LeftClick"
  }
]
