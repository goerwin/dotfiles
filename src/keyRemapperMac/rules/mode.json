// "Mode - *" rules (mirrors .config/karabiner/rules/mode.ts)
[
  // Mode - VIM
  {
    "from": ["H", "J", "K", "L"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "if": "vimShift",
    "to": [
      "ShiftL+LeftArrow",
      "ShiftL+DownArrow",
      "ShiftL+UpArrow",
      "ShiftL+RightArrow"
    ]
  },
  {
    "from": ["H", "J", "K", "L"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "to": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"]
  },
  {
    "from": ["F"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "to": "set:vimShift",
    "afterKeyUp": "unset:vimShift"
  },

  // Mode - Click
  {
    "from": ["C"],
    "modifiers": ["AltL", "F18"],
    "optional": ["any"],
    "to": "RightClick"
  },
  {
    "from": ["C"],
    "modifiers": ["AltL"],
    "optional": ["any"],
    "to": "LeftClick"
  }
]
