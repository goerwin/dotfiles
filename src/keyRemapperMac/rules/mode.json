// "Mode - *" rules (mirrors .config/karabiner/rules/mode.ts)
[
  // Mode - VIM
  {
    "keys": ["F18"],
    "if": { "isKeyDown": false, "_vimMode": true, "_vimModeShiftL": true },
    "setOnKeyUp": { "_vimMode": false, "_vimModeShiftL": false },
    "send": [null, "ShiftL:up"]
  },
  {
    "keys": ["F18"],
    "set": { "_vimMode": true },
    "setOnKeyUp": { "_vimMode": false },
    "send": [null, null]
  },
  {
    "keys": ["H", "J", "K", "L"],
    "mappedKeys": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"],
    "if": { "_vimMode": true },
    "send": ["mappedKey:down", "mappedKey:up"]
  },
  {
    "keys": ["F"],
    "if": { "_vimMode": true },
    "set": { "_vimModeShiftL": true },
    "setOnKeyUp": { "_vimModeShiftL": false },
    "send": ["ShiftL:down", "ShiftL:up"]
  },

  // Mode - Click
  {
    "keys": ["C"],
    "if": { "AltL": true, "F18": true },
    "set": { "rightClickMode": true },
    "setOnKeyUp": { "rightClickMode": false },
    "send": ["AltL:up RightClick:down", "RightClick:up"],
    "afterKeyUp": "AltL:down"
  },
  {
    "keys": ["C"],
    "if": { "AltL": true },
    "set": { "leftClickMode": true },
    "setOnKeyUp": { "leftClickMode": false },
    "send": ["AltL:up LeftClick:down", "LeftClick:up"],
    "afterKeyUp": "AltL:down"
  },
  {
    "keys": ["AltL"],
    "if": { "isKeyDown": false, "leftClickMode": true },
    "setOnKeyUp": { "leftClickMode": false },
    "send": [null, "LeftClick:up AltL:up"]
  },
  {
    "keys": ["AltL"],
    "if": { "isKeyDown": false, "rightClickMode": true },
    "setOnKeyUp": { "rightClickMode": false },
    "send": [null, "RightClick:up AltL:up"]
  }
]
