// "Global - *" rules (mirrors .config/karabiner/rules/global.ts)
[
  // Global - CapsLock to F18 (see _remaps.json), tap to Esc
  { "from": ["F18"], "optional": ["any"], "tap": "Esc" },

  // Global - Capslock as Control for some keys
  {
    "from": ["C", "V", "E", "Space", "Tab"],
    "modifiers": ["F18"],
    "optional": ["any"],
    "to": "CtrlL+currentKey"
  },

  // Global - Cmd[shift] + J/K to PageDown/PageUp and restore it with Fn + J/K
  {
    "from": ["J", "K"],
    "modifiers": ["CmdL"],
    "optional": ["ShiftL"],
    "to": ["PageDown", "PageUp"]
  },
  {
    "from": ["J", "K"],
    "modifiers": ["Fn"],
    "optional": ["any"],
    "to": "CmdL+currentKey"
  },

  // Global - App Exposé
  {
    "from": ["J"],
    "modifiers": ["CmdL", "AltL"],
    "to": "CtrlL+DownArrow"
  },

  // Global - Double Fn to Cmd + option + 9 (whisperer)
  {
    "from": ["Fn"],
    "optional": ["any"],
    "to": "Fn",
    "doubleTap": "CmdL+AltL+9"
  },

  // Global - Double Shift to Capslock
  {
    "from": ["ShiftL"],
    "optional": ["any"],
    "to": "ShiftL",
    "doubleTap": "Caps"
  },

  // Global - Function Keys
  {
    // Cmd + F-key sends the plain F-key (Apps (Starcraft2) overrides F1/F2)
    "from": ["F1", "F2", "F7", "F8", "F9", "F10", "F11", "F12"],
    "modifiers": ["CmdL"],
    "optional": ["any"],
    "to": "currentKey"
  },
  {
    "from": ["F1", "F2", "F7", "F8", "F9", "F10", "F11", "F12"],
    "to": [
      "BrightnessDown",
      "BrightnessUp",
      "Rewind",
      "PlayPause",
      "FastForward",
      "Mute",
      "VolumeDown",
      "VolumeUp"
    ]
  },

  // Global - Local PW (generated from _localPw.ts)
  "%import(_localPw.json)",

  // KeyRemapper only (Karabiner doesn't need these)

  // macOS fn+backspace/arrows, lost because the keyboard is seized
  {
    "from": ["Backspace", "UpArrow", "DownArrow", "LeftArrow", "RightArrow"],
    "modifiers": ["Fn"],
    "optional": ["any"],
    "to": ["ForwardDelete", "PageUp", "PageDown", "Home", "End"]
  }
]
