// "Global - *" rules (mirrors .config/karabiner/rules/global.ts)
[
  // Global - CapsLock to F18: see _remaps.json and _keyPresses.json

  // Global - Capslock as Control for some keys
  {
    "keys": ["C", "V", "E", "Space", "Tab"],
    "if": { "F18": true },
    "send": ["CtrlL:down currentKey CtrlL:up", "currentKey:up"]
  },

  // Global - Cmd[shift] + J/K to PageDown/PageUp and restore it with Fn + J/K
  {
    "keys": ["J", "K"],
    "mappedKeys": ["PageDown", "PageUp"],
    "if": { "CmdL": true, "AltL": false },
    "send": ["CmdL:up mappedKey:down", "mappedKey:up currentKey:up CmdL:down"]
  },
  {
    "keys": ["J", "K"],
    "if": { "Fn": true },
    "send": ["Fn:up CmdL:down currentKey:down CmdL:up Fn:down", "currentKey:up"]
  },

  // Global - App Exposé
  {
    "keys": ["J"],
    "if": { "CmdL": true, "AltL": true, "ShiftL": false },
    "send": [
      "CmdL:up AltL:up CtrlL:down DownArrow CtrlL:up CmdL:down AltL:down",
      "currentKey:up"
    ]
  },

  // Global - Double Fn to Cmd + option + 9 (whisperer): see _keyPresses.json

  // Global - Double Shift to Capslock: see _keyPresses.json

  // Global - Function Keys
  {
    // Cmd + F-key sends the plain F-key (Apps (Starcraft2) overrides F1/F2)
    "keys": ["F1", "F2", "F7", "F8", "F9", "F10", "F11", "F12"],
    "if": { "CmdL": true },
    "send": ["CmdL:up currentKey CmdL:down", "currentKey:up"]
  },
  {
    // held down, so they repeat
    "keys": ["F1", "F2", "F11", "F12"],
    "mappedKeys": ["BrightnessDown", "BrightnessUp", "VolumeDown", "VolumeUp"],
    "send": ["mappedKey:down", "mappedKey:up"]
  },
  {
    // tapped, so they don't repeat
    "keys": ["F7", "F8", "F9", "F10"],
    "mappedKeys": ["Rewind", "PlayPause", "FastForward", "Mute"],
    "send": ["mappedKey", null]
  },

  // Global - Local PW (generated from _localPw.ts)
  "%dotdotdotArray(_localPw.json)",

  // KeyRemapper only (Karabiner doesn't need these)

  // macOS fn+backspace/arrows, lost because the keyboard is seized
  {
    "keys": ["Backspace", "UpArrow", "DownArrow", "LeftArrow", "RightArrow"],
    "mappedKeys": ["ForwardDelete", "PageUp", "PageDown", "Home", "End"],
    "if": { "Fn": true },
    "send": ["mappedKey:down", "mappedKey:up currentKey:up"]
  }
]
