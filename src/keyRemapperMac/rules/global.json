// "Global - *" rules (mirrors .config/karabiner/rules/global.ts)
[
  // Global - CapsLock to F18: see _remaps.json and _keyPresses.json

  // Global - Capslock as Control for some keys
  {
    "keys": ["C", "V", "E", "Space", "Tab"],
    "if": { "F18": true },
    "send": ["CtrlL:down currentKey CtrlL:up", "currentKey:up"]
  },

  // Global - Cmd[shift] + J/K to PageDown/PageUp and restore it with Fn + J/K
  {
    "keys": ["J"],
    "if": { "CmdL": true, "AltL": false },
    "send": ["CmdL:up PageDown:down", "PageDown:up currentKey:up CmdL:down"],
    // is this neccesary
    "afterKeyUp": "CmdL:down"
  },
  {
    "keys": ["K"],
    "if": { "CmdL": true, "AltL": false },
    "send": ["CmdL:up PageUp:down", "PageUp:up currentKey:up CmdL:down"],
    "afterKeyUp": "CmdL:down"
  },
  {
    "keys": ["J", "K"],
    "if": { "Fn": true },
    "send": ["Fn:up CmdL:down currentKey:down CmdL:up Fn:down", "currentKey:up"]
  },

  // Global - App Exposé
  {
    "keys": ["J"],
    "if": { "CmdL": true, "AltL": true, "ShiftL": false },
    "send": [
      "CmdL:up AltL:up CtrlL:down DownArrow CtrlL:up CmdL:down AltL:down",
      "currentKey:up"
    ]
  },

  // Global - Double Fn to Cmd + option + 9 (whisperer): see _keyPresses.json

  // Global - Double Shift to Capslock: see _keyPresses.json

  // Global - Function Keys
  {
    // Cmd + F-key sends the plain F-key (Apps (Starcraft2) overrides F1/F2)
    "keys": ["F1", "F2", "F7", "F8", "F9", "F10", "F11", "F12"],
    "if": { "CmdL": true },
    "send": ["CmdL:up currentKey CmdL:down", "currentKey:up"]
  },
  { "keys": ["F1"], "send": ["BrightnessDown:down", "BrightnessDown:up"] },
  { "keys": ["F2"], "send": ["BrightnessUp:down", "BrightnessUp:up"] },
  { "keys": ["F7"], "send": ["Rewind"] },
  { "keys": ["F8"], "send": ["PlayPause"] },
  { "keys": ["F9"], "send": ["FastForward"] },
  { "keys": ["F10"], "send": ["Mute"] },
  { "keys": ["F11"], "send": ["VolumeDown:down", "VolumeDown:up"] },
  { "keys": ["F12"], "send": ["VolumeUp:down", "VolumeUp:up"] },

  // Global - Local PW (generated from _localPw.ts)
  "%dotdotdotArray(_localPw.json)",

  // KeyRemapper only (Karabiner doesn't need these)

  // macOS fn+backspace/arrows, lost because the keyboard is seized
  {
    "keys": ["Backspace"],
    "if": { "Fn": true },
    "send": ["ForwardDelete:down", "ForwardDelete:up currentKey:up"]
  },
  {
    "keys": ["UpArrow"],
    "if": { "Fn": true },
    "send": ["PageUp:down", "PageUp:up currentKey:up"]
  },
  {
    "keys": ["DownArrow"],
    "if": { "Fn": true },
    "send": ["PageDown:down", "PageDown:up currentKey:up"]
  },
  {
    "keys": ["LeftArrow"],
    "if": { "Fn": true },
    "send": ["Home:down", "Home:up currentKey:up"]
  },
  {
    "keys": ["RightArrow"],
    "if": { "Fn": true },
    "send": ["End:down", "End:up currentKey:up"]
  },

  // NOTE: at the very end, release all possible keys
  // that can still be on down on other shortcuts
  {
    "keys": ["J"],
    "send": ["currentKey:down", "PageDown:up DownArrow:up currentKey:up"]
  },
  {
    "keys": ["K"],
    "send": ["currentKey:down", "PageUp:up UpArrow:up currentKey:up"]
  },
  {
    "keys": ["H"],
    "send": ["currentKey:down", "LeftArrow:up currentKey:up"]
  },
  {
    "keys": ["L"],
    "send": ["currentKey:down", "RightArrow:up currentKey:up"]
  },
  {
    "keys": ["Backspace"],
    "send": ["currentKey:down", "ForwardDelete:up currentKey:up"]
  },
  {
    "keys": ["UpArrow"],
    "send": ["currentKey:down", "PageUp:up currentKey:up"]
  },
  {
    "keys": ["DownArrow"],
    "send": ["currentKey:down", "PageDown:up currentKey:up"]
  },
  {
    "keys": ["LeftArrow"],
    "send": ["currentKey:down", "Home:up currentKey:up"]
  },
  {
    "keys": ["RightArrow"],
    "send": ["currentKey:down", "End:up currentKey:up"]
  }
]
