// "Device - *" rules (mirrors .config/karabiner/rules/devices.ts)
// G10 Control (keyboard: productId:vendorId)
[
  // Device - G10 Control - Apps (Anki)
  {
    "keys": ["LeftArrow", "RightArrow", "Back", "DownArrow", "PlayPause"],
    "mappedKeys": ["1", "4", "D", "Tab", "R"],
    "if": { "keyboard": "4133:6421", "appName": "net.ankiweb.launcher" },
    "send": ["mappedKey:down", "mappedKey:up"]
  },
  {
    // Up to Shift + Tab
    "keys": ["UpArrow"],
    "if": { "keyboard": "4133:6421", "appName": "net.ankiweb.launcher" },
    "send": ["ShiftL:down Tab ShiftL:up", null]
  },

  // Device - G10 Control - Apps (Vocabuler)
  {
    // Mic to Enter, Play/Pause to `
    "keys": [
      "Application",
      "Enter",
      "Dictation",
      "PlayPause",
      "UpArrow",
      "RightArrow",
      "DownArrow",
      "LeftArrow"
    ],
    "mappedKeys": ["Tab", "Space", "Enter", "GraveAccent", "1", "2", "3", "4"],
    "if": {
      "keyboard": "4133:6421",
      "appName": "com.google.Chrome.app.eaigkbdbodohacojejngkapnlolpkjck"
    },
    "send": ["mappedKey:down", "mappedKey:up"]
  },
  {
    // Back to Shift + Tab
    "keys": ["Back"],
    "if": {
      "keyboard": "4133:6421",
      "appName": "com.google.Chrome.app.eaigkbdbodohacojejngkapnlolpkjck"
    },
    "send": ["ShiftL:down Tab:down", "Tab:up ShiftL:up"]
  },

  // Device - G10 Control - Apps (Google Chrome)
  {
    "keys": ["Enter", "PlayPause"],
    "mappedKeys": ["Space", "Esc"],
    "if": { "keyboard": "4133:6421", "appName": "com.google.Chrome" },
    "send": ["mappedKey:down", "mappedKey:up"]
  },

  // Device - G10 Control
  {
    // Page Down/Up to Volume Down/Up, Volume Down/Up to Brightness Down/Up
    "keys": ["PageDown", "PageUp", "VolumeDown", "VolumeUp"],
    "mappedKeys": ["VolumeDown", "VolumeUp", "BrightnessDown", "BrightnessUp"],
    "if": { "keyboard": "4133:6421" },
    "send": ["mappedKey:down", "mappedKey:up"]
  },
  {
    // Delete[Hold] to Ctrl + Shift + Tab [Close tab: Cmd + W]
    // Mute[Hold] to Ctrl + Tab [App switcher: Cmd + Shift + Tab]
    // tap and hold are in _keyPresses.json, this only silences the keys
    "keys": ["Backspace", "Mute"],
    "if": { "keyboard": "4133:6421" },
    "send": [null, null]
  }
]
