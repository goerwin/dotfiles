// "Device - *" rules (mirrors .config/karabiner/rules/devices.ts)
// G10 Control (keyboard: productId:vendorId)
[
  // Device - G10 Control - Apps (Anki)
  {
    "from": [
      "LeftArrow",
      "RightArrow",
      "Back",
      "DownArrow",
      "UpArrow",
      "PlayPause"
    ],
    "keyboard": "4133:6421",
    "app": "net.ankiweb.launcher",
    "to": ["1", "4", "D", "Tab", "ShiftL+Tab", "R"]
  },

  // Device - G10 Control - Apps (Vocabuler)
  {
    "from": [
      "Back",
      "Application",
      "Enter",
      "Dictation",
      "PlayPause",
      "UpArrow",
      "RightArrow",
      "DownArrow",
      "LeftArrow"
    ],
    "keyboard": "4133:6421",
    "app": "com.google.Chrome.app.eaigkbdbodohacojejngkapnlolpkjck",
    "to": [
      "ShiftL+Tab",
      "Tab",
      "Space",
      "Enter",
      "GraveAccent",
      "1",
      "2",
      "3",
      "4"
    ]
  },

  // Device - G10 Control - Apps (Google Chrome)
  {
    "from": ["Enter", "PlayPause"],
    "keyboard": "4133:6421",
    "app": "com.google.Chrome",
    "to": ["Space", "Esc"]
  },

  // Device - G10 Control
  {
    // Page Down/Up to Volume Down/Up, Volume Down/Up to Brightness Down/Up
    "from": ["PageDown", "PageUp", "VolumeDown", "VolumeUp"],
    "keyboard": "4133:6421",
    "to": ["VolumeDown", "VolumeUp", "BrightnessDown", "BrightnessUp"]
  },
  {
    // Delete[Hold] to Ctrl + Shift + Tab [Close tab: Cmd + W]
    "from": ["Backspace"],
    "keyboard": "4133:6421",
    "tap": "CtrlL+ShiftL+Tab",
    "hold": "CmdL+W"
  },
  {
    // Mute[Hold] to Ctrl + Tab [App switcher: Cmd + Shift + Tab, open until
    // Mute is released]
    "from": ["Mute"],
    "keyboard": "4133:6421",
    "tap": "CtrlL+Tab",
    "hold": "CmdL+ShiftL+Tab"
  }
]
