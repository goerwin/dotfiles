// "Apps (...)" rules (mirrors .config/karabiner/rules/apps.ts)
[
  // Apps (Finder, Google Chrome, Supacode, Warp, Xcode) - Cmd + H/L and F3/F4 to prev/next tab
  {
    "from": ["H", "L"],
    "modifiers": ["CmdL"],
    "app": "%import(_tabberApps.json)",
    "to": ["CtrlL+ShiftL+Tab", "CtrlL+Tab"]
  },
  {
    "from": ["F3", "F4"],
    "app": "%import(_tabberApps.json)",
    "to": ["CtrlL+ShiftL+Tab", "CtrlL+Tab"]
  },

  // Apps (Google Chrome) - Cmd + ; to Cmd + L
  {
    "from": ["Semicolon"],
    "modifiers": ["CmdL"],
    "app": "com.google.Chrome",
    "to": "CmdL+L"
  },

  // Apps (Google Chrome) - F5 to Alt + U and F6 to Alt + T
  {
    "from": ["F5", "F6"],
    "app": "com.google.Chrome",
    "to": ["AltL+U", "AltL+T"]
  },

  // Apps (Google Chrome) - Toggle full-screen
  {
    "from": ["F"],
    "modifiers": ["CmdL", "AltL"],
    "app": "com.google.Chrome",
    "to": "CmdL+CtrlL+F"
  },

  // Apps (Google Chrome) - Unfocus omnibar
  {
    // gives focus back to the page
    "from": ["E"],
    "modifiers": ["CmdL"],
    "app": "com.google.Chrome",
    "to": "CmdL+L delay:25 Semicolon delay:25 Esc delay:25 Esc CmdL+AltL+UpArrow"
  },

  // Apps (Google Chrome) - Cmd + shift + i to toggle dev tools
  {
    "from": ["I"],
    "modifiers": ["CmdL", "ShiftL"],
    "app": "com.google.Chrome",
    "to": "CmdL+AltL+I"
  },

  // Apps (Slack) - Cmd + P to search
  {
    "from": ["P"],
    "modifiers": ["CmdL"],
    "app": "com.tinyspeck.slackmacgap",
    "to": "CmdL+K"
  },

  // Apps (Supacode) - Cmd + O to clear terminal
  {
    "from": ["O"],
    "modifiers": ["CmdL"],
    "app": "app.supabit.supacode",
    "to": "CmdL+K"
  },

  // Apps (Starcraft2) - Modifications
  {
    // this is for autorepair (c is the hotkey for repair, so cmd + d is for autorepair)
    "from": ["D"],
    "modifiers": ["CmdL"],
    "app": "com.blizzard.starcraft2",
    "to": "AltL+C"
  },
  {
    // keep cmd+F1/F2 as is (outside SC2 they are sent as plain F1/F2)
    "from": ["F1", "F2"],
    "modifiers": ["CmdL"],
    "optional": ["any"],
    "app": "com.blizzard.starcraft2",
    "to": "CmdL+currentKey"
  }
]
