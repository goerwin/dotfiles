// "Apps (...)" rules (mirrors .config/karabiner/rules/apps.ts)
[
  // Apps (Finder, Google Chrome, Supacode, Warp, Xcode) - Cmd + H/L and F3/F4 to prev/next tab
  {
    "keys": ["H"],
    "if": {
      "appName": [
        "com.apple.finder",
        "com.google.Chrome",
        "app.supabit.supacode",
        "dev.warp.Warp-Stable",
        "com.apple.dt.Xcode"
      ],
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": [
      "CmdL:up CtrlL:down ShiftL:down Tab ShiftL:up CtrlL:up CmdL:down",
      "currentKey:up"
    ]
  },
  {
    "keys": ["L"],
    "if": {
      "appName": [
        "com.apple.finder",
        "com.google.Chrome",
        "app.supabit.supacode",
        "dev.warp.Warp-Stable",
        "com.apple.dt.Xcode"
      ],
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CmdL:up CtrlL:down Tab CtrlL:up CmdL:down", "currentKey:up"]
  },
  {
    "keys": ["F3"],
    "if": {
      "appName": [
        "com.apple.finder",
        "com.google.Chrome",
        "app.supabit.supacode",
        "dev.warp.Warp-Stable",
        "com.apple.dt.Xcode"
      ],
      "CmdL": false,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CtrlL:down ShiftL:down Tab ShiftL:up CtrlL:up", "currentKey:up"]
  },
  {
    "keys": ["F4"],
    "if": {
      "appName": [
        "com.apple.finder",
        "com.google.Chrome",
        "app.supabit.supacode",
        "dev.warp.Warp-Stable",
        "com.apple.dt.Xcode"
      ],
      "CmdL": false,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CtrlL:down Tab CtrlL:up", "currentKey:up"]
  },

  // Apps (Google Chrome) - Cmd + ; to Cmd + L
  {
    "keys": ["Semicolon"],
    "if": { "appName": "com.google.Chrome", "CmdL": true, "AltL": false },
    "send": ["CmdL:down L CmdL:up CmdL:down", "currentKey:up"]
  },

  // Apps (Google Chrome) - F5 to Alt + U and F6 to Alt + T
  {
    "keys": ["F5"],
    "if": { "appName": "com.google.Chrome" },
    "send": ["AltL:down U AltL:up", "currentKey:up"]
  },
  {
    "keys": ["F6"],
    "if": { "appName": "com.google.Chrome" },
    "send": ["AltL:down T AltL:up", "currentKey:up"]
  },

  // Apps (Google Chrome) - Toggle full-screen
  {
    "keys": ["F"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": true,
      "ShiftL": false
    },
    "send": [
      "AltL:up CtrlL:down currentKey CtrlL:up AltL:down",
      "currentKey:up"
    ]
  },

  // Apps (Google Chrome) - Unfocus omnibar
  {
    // gives focus back to the page
    "keys": ["E"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": [
      "L SK:Delay:25 CmdL:up Semicolon SK:Delay:25 Esc SK:Delay:25 Esc CmdL:down AltL:down UpArrow AltL:up",
      "currentKey:up"
    ]
  },

  // Apps (Google Chrome) - Cmd + shift + i to toggle dev tools
  {
    "keys": ["I"],
    "if": { "appName": "com.google.Chrome", "CmdL": true, "ShiftL": true },
    "send": ["ShiftL:up AltL:down I AltL:up ShiftL:down", "currentKey:up"]
  },

  // Apps (Slack) - Cmd + P to search
  {
    "keys": ["P"],
    "if": {
      "appName": "com.tinyspeck.slackmacgap",
      "CmdL": true,
      "AltL": false
    },
    "send": ["K", "currentKey:up"]
  },

  // Apps (Supacode) - Cmd + O to clear terminal
  {
    "keys": ["O"],
    "if": {
      "appName": "app.supabit.supacode",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["K", "currentKey:up"]
  },

  // Apps (Starcraft2) - Modifications
  {
    // this is for autorepair (c is the hotkey for repair, so cmd + d is for autorepair)
    "keys": ["D"],
    "if": { "appName": "com.blizzard.starcraft2", "CmdL": true },
    "send": ["CmdL:up AltL:down C AltL:up CmdL:down", "currentKey:up"]
  },
  {
    // keep cmd+F1/F2 as is (outside SC2 they are sent as plain F1/F2)
    "keys": ["F1", "F2"],
    "if": { "appName": "com.blizzard.starcraft2", "CmdL": true },
    "send": ["currentKey:down", "currentKey:up"]
  }
]
