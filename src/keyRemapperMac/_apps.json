[
  // Tab switching: Cmd+H/L and F3/F4 to prev/next tab
  // (Google Chrome, Finder, Warp, Xcode, Supacode)

  {
    "keys": ["H"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": [
      "CmdL:up CtrlL:down ShiftL:down Tab ShiftL:up CtrlL:up CmdL:down",
      "currentKey:up"
    ]
  },
  {
    "keys": ["L"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CmdL:up CtrlL:down Tab CtrlL:up CmdL:down", "currentKey:up"]
  },
  {
    "keys": ["F3"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": false,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CtrlL:down ShiftL:down Tab ShiftL:up CtrlL:up", "currentKey:up"]
  },
  {
    "keys": ["F4"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": false,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["CtrlL:down Tab CtrlL:up", "currentKey:up"]
  },

  {
    "keys": ["H"],
    "if": {
      "appName": "com.apple.finder",
      "CmdL": true,
