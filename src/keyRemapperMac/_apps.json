    "send": ["CtrlL:down Tab CtrlL:up", "currentKey:up"]
  },

  // Google Chrome

  {
    "keys": ["Semicolon"],
    "if": { "appName": "com.google.Chrome", "CmdL": true, "AltL": false },
    "send": ["CmdL:down L CmdL:up CmdL:down", "currentKey:up"]
  },
  {
    "keys": ["F5"],
    "if": { "appName": "com.google.Chrome" },
    "send": ["AltL:down M AltL:up", "currentKey:up"]
  },
  {
    "keys": ["F6"],
    "if": { "appName": "com.google.Chrome" },
    "send": ["AltL:down T AltL:up", "currentKey:up"]
  },
  {
    // full screen
    "keys": ["F"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": true,
      "ShiftL": false
    },
    "send": [
      "AltL:up CtrlL:down currentKey CtrlL:up AltL:down",
      "currentKey:up"
    ]
  },
  {
    // unfocus omnibar and give focus back to page
    "keys": ["E"],
    "if": {
      "appName": "com.google.Chrome",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": [
      "L SK:Delay:25 CmdL:up Semicolon SK:Delay:25 Esc SK:Delay:25 Esc CmdL:down AltL:down UpArrow AltL:up",
      "currentKey:up"
    ]
  },
  {
    // cmd+shift+i for toggling dev tools
    "keys": ["I"],
    "if": { "appName": "com.google.Chrome", "CmdL": true, "ShiftL": true },
    "send": ["ShiftL:up AltL:down I AltL:up ShiftL:down", "currentKey:up"]
  },

  // Starcraft II

  {
    // keep cmd+F1/F2 as is (outside SC2 they are sent as plain F1/F2)
    "keys": ["F1", "F2"],
    "if": { "appName": "com.blizzard.starcraft2", "CmdL": true },
    "send": ["currentKey:down", "currentKey:up"]
  },
  {
    // this is for autorepair (c is the hotkey for repair, so cmd + d is for autorepair)
    "keys": ["D"],
    "if": { "appName": "com.blizzard.starcraft2", "CmdL": true },
    "send": ["CmdL:up AltL:down C AltL:up CmdL:down", "currentKey:up"]
  },

  // Slack

  {
    "keys": ["P"],
    "if": {
      "appName": "com.tinyspeck.slackmacgap",
      "CmdL": true,
      "AltL": false
    },
    "send": ["K", "currentKey:up"]
  },

  // Supacode

  {
    // clear terminal
    "keys": ["O"],
    "if": {
      "appName": "app.supabit.supacode",
      "CmdL": true,
      "AltL": false,
      "CtrlL": false,
      "ShiftL": false
    },
    "send": ["K", "currentKey:up"]
  }
]
