#!/usr/bin/env python3

import argparse
import json
import os
import sys

from goerwin_tools.runtime import CommandError, DEFAULT_CONFIG, register_checkout
from goerwin_tools.worktrees import switch


def main():
    parser = argparse.ArgumentParser(
        description="Create or reuse a development worktree; print its path without changing cwd.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  goerwin-wts 123
  goerwin-wts https://github.com/owner/repo/pull/123
  goerwin-wts feat/component origin/main
  goerwin-wts register /path/to/repo

Existing branches are reused as-is (base is ignored). New branches start from
the fetched remote default unless a base is given. PR URLs from other
repositories need a registered local clone. Worktrunk paths and hooks apply;
Herdr focus is best-effort. Agents: use --json --no-focus and work in .path.""",
    )
    parser.add_argument("target", help="PR number, PR URL, branch name, or 'register'")
    parser.add_argument("base", nargs="?", help="Base for a new branch; checkout path with register")
    parser.add_argument("-C", "--cwd", default=os.getcwd(), help="Repository/context directory (default: current directory)")
    parser.add_argument("--config", default=str(DEFAULT_CONFIG), help="Repository registry file")
    parser.add_argument("--github-user", help="Use an existing gh account without switching the active account")
    parser.add_argument("--json", action="store_true", help="Print JSON; worktree results include path and branch")
    parser.add_argument("--no-focus", action="store_true", help="Skip Herdr navigation")
    args = parser.parse_args()
    try:
        if args.target == "register":
            result = register_checkout(args.base or args.cwd, args.config)
            path = result["source_root"]
        else:
            result = switch(args.target, args.cwd, args.base, args.config, args.github_user, not args.no_focus)
            path = result["path"]
        print(json.dumps(result, indent=2) if args.json else path)
        for warning in result.get("herdr", {}).get("warnings", []):
            print(f"Herdr: {warning}", file=sys.stderr)
        return 0
    except (CommandError, OSError) as error:
        print(f"goerwin-wts: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
